# Generation key, set in the Render dashboard. An absent or revoked key does not
# stop the service booting, it only makes /chat fail, so /health reports it.
NVIDIA_API_KEY=your_nvidia_generation_key_here
# Separate key for retrieval, so embedding traffic has its own quota. This one is
# required at startup: the policy documents are embedded while the index builds.
NVIDIA_EMBEDDING_API_KEY=your_nvidia_retrieval_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.5
LLM_TOP_P=1
LLM_MAX_TOKENS=1024
LLM_MAX_ATTEMPTS=3
EMBED_MODEL=nvidia/nemotron-3-embed-1b
MIN_SCORE=0.40
# Cookies are only sent cross-origin when this says the response may set them, so
# `*` breaks sign-in. List the frontend origins explicitly.
ALLOWED_ORIGINS=https://your-frontend.example,http://localhost:4200
DATABASE_URL=postgresql://user:password@localhost:5432/knowledge_assistant

# --- Authentication -----------------------------------------------------------
# `production` is the only value that changes behaviour: it forces Secure cookies
# and refuses to seed a development administrator.
ENVIRONMENT=development

# Signs both token types. Must be at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it signs every existing session out, which is the intended effect.
AUTH_SECRET_KEY=

# Accounts exist only for these addresses. Enforced by the request validators, not
# by the browser.
COMPANY_EMAIL_DOMAIN=acmetech.example

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
INVITE_TTL_SECONDS=259200
BCRYPT_ROUNDS=12

# Where an invitation link points. If this is wrong the link reaches nothing.
FRONTEND_BASE_URL=http://localhost:4200

# `false` only for local http development. Production forces it on regardless, so
# a misconfigured deployment fails closed rather than issuing cookies insecurely.
AUTH_COOKIE_SECURE=true

# Origins allowed to make cookie-authenticated state-changing requests. Defaults
# to ALLOWED_ORIGINS when unset.
#
# The origin must be spelled exactly as the browser sends it, host included — and
# `localhost` and `127.0.0.1` are different origins. A mismatch does not fail loudly:
# the requests are simply refused with a 403, which looks like a broken interceptor.
# Both the CORS origin and this one have to be the app's real address.
# CSRF_TRUSTED_ORIGINS=https://your-frontend.example,http://localhost:4200

# Guards POST /api/auth/bootstrap-admin, the one route that can create the first
# administrator. Separate from AUTH_SECRET_KEY on purpose: being handed one must
# not mean being handed the ability to mint tokens. Prefer creating the first
# administrator with `python -m app.bootstrap_admin` and leaving this unset.
AUTH_BOOTSTRAP_KEY=

# An optional development administrator, seeded at startup when both halves are
# set and refused when ENVIRONMENT=production. Remove it once a real
# administrator exists.
AUTH_SEED_ADMIN_EMAIL=
AUTH_SEED_ADMIN_PASSWORD=
AUTH_SEED_ADMIN_NAME=Administrator